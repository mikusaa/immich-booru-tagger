# Immich 服务根地址，不加 /api。
IMMICH_BASE_URL=http://immich-server:2283

# 三种认证方式只启用一种；下面以一个用户为例。
IMMICH_API_KEY=replace-with-your-api-key
# IMMICH_API_KEYS=["key1","key2"]
# IMMICH_LIBRARIES={"Alice":"key1","Bob":"key2"}

# 外部库 UUID；不是目录名。逗号分隔或 JSON 数组均可。
# 空 include 会处理当前 API 用户可见的全部图片。
IMMICH_INCLUDE_LIBRARY_IDS=
IMMICH_INCLUDE_ALBUM_IDS=
IMMICH_EXCLUDE_LIBRARY_IDS=
SEARCH_API=auto

BATCH_SIZE=250
PROCESSED_TAG_NAME=auto:processed
FAILURE_TIMEOUT=3
TAG_CACHE_TTL=300
STATE_DIR=/app/state

TAGGING_MODEL=wd14
MODEL_REPO=SmilingWolf/wd-swinv2-tagger-v3
MODEL_CACHE_DIR=/app/models
GENERAL_THRESHOLD=0.35
CHARACTER_THRESHOLD=0.90
TRANSLATIONS_ENABLED=true
# 覆盖文件需要放进已挂载的 state 目录。
# TRANSLATION_OVERRIDES=/app/state/tag_overrides.json

ENABLE_SCHEDULER=true
CRON_SCHEDULE=0 2 * * *
TIMEZONE=Asia/Shanghai
RUN_ON_STARTUP=false

LOG_LEVEL=INFO
MAX_RETRIES=3
RETRY_DELAY=1.0
REQUEST_TIMEOUT=30.0

# 正式使用时建议固定版本或镜像 digest。
TAGGER_IMAGE=ghcr.io/mikusaa/immich-booru-tagger:main
